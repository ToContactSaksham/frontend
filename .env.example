# Public URL of the deployed site (used for metadata, OG image, sitemap).
# Defaults to the Netlify production domain when unset.
NEXT_PUBLIC_SITE_URL=https://sakshamportfolio20.netlify.app

# GitHub account shown in the "GitHub" section (defaults to ToContactSaksham).
GITHUB_USERNAME=ToContactSaksham

# Optional: a fine-grained personal access token with no scopes raises the
# GitHub REST API rate limit from 60 to 5,000 requests per hour. Never exposed
# to the browser; only read inside the /api/github route handler.
# GITHUB_TOKEN=github_pat_xxx
